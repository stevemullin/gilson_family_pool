# Server-only. Do NOT rename these to NEXT_PUBLIC_* — Next.js inlines those at build
# time, but Vercel injects Secret-typed variables only at runtime, so the combination
# compiles to undefined. Nothing here needs to reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
MAIL_FROM=pool@example.com
CRON_SECRET=
SITE_URL=http://localhost:3000
